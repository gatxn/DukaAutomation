# Reference only: Django does not load this file automatically.
# Set these values in your host environment before starting web + worker.

# --- Core ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=shop.example.com

# --- Database ---
# Unset (or absent) keeps local SQLite. Set this to switch to PostgreSQL, e.g.:
# postgres://duka:password@db-host:5432/duka
DATABASE_URL=

# --- Credential encryption (provider tokens at rest) ---
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back up the key securely. Changing it makes existing credentials unreadable.
CREDENTIAL_ENCRYPTION_KEY=replace-with-generated-fernet-key

# --- AI assistant ---
AI_MODEL=gpt-4.1-mini
# Merchant OpenAI/Ghala/Snippe API tokens belong in the signed-in Settings / Assistant screens.
# They are encrypted per shop, and are NOT read from this example file.

# --- OTP delivery (signup verification + password reset) ---
# Unset means signup/reset via that channel fails with a clean "not configured yet" error
# instead of silently no-op-ing — set these before relying on either channel for real users.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Duka <no-reply@duka.example.com>
# Meta WhatsApp Cloud API (cheapest; used for OTP whenever WHATSAPP_CLOUD_TOKEN is set).
# Token = permanent System User access token with whatsapp_business_messaging permission.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_VERSION=v24.0
# A Ghala team API key the platform itself owns (Settings -> Developer -> API Keys) -- not a
# merchant's per-shop Ghala credential, which is entered in the app's own Settings screen instead.
# Africa's Talking SMS OTP. Username 'sandbox' uses their simulator (no real delivery).
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
GHALA_API_KEY=
GHALA_OTP_TEMPLATE_NAME=
GHALA_OTP_TEMPLATE_LANGUAGE=en
OTP_TTL_SECONDS=300

# --- Inbound WhatsApp (Meta Cloud API) -> AI replies ---
# App secret verifies webhook signatures; the verify token is a random string you also enter in Meta.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# 1 = the web process runs queued jobs itself (no separate worker). Leave 0 if you run process_jobs.
INLINE_JOB_PROCESSING=0

# --- Observability (optional) ---
# Unset disables Sentry entirely (no-op, no dependency on having an account).
SENTRY_DSN=
