# Reference only: Django does not load this file automatically.
# Set these values in your host environment before starting web + worker.

# --- Core ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=shop.example.com

# --- Database ---
# Unset (or absent) keeps local SQLite. Set this to switch to PostgreSQL, e.g.:
# postgres://duka:password@db-host:5432/duka
DATABASE_URL=

# --- Credential encryption (provider tokens at rest) ---
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back up the key securely. Changing it makes existing credentials unreadable.
CREDENTIAL_ENCRYPTION_KEY=replace-with-generated-fernet-key

# --- AI assistant ---
AI_MODEL=gpt-4.1-mini
# Merchant OpenAI/Ghala/Snippe API tokens belong in the signed-in Settings / Assistant screens.
# They are encrypted per shop, and are NOT read from this example file.

# --- Email (password reset) ---
# Unset uses Django's console backend in DEBUG (prints to stdout) — fine for local dev only.
# In production, set real SMTP credentials or the workflow will fail to send reset emails.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@duka.example.com

# --- Observability (optional) ---
# Unset disables Sentry entirely (no-op, no dependency on having an account).
SENTRY_DSN=
